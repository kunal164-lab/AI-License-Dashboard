# =============================================================================
# ENVIRONMENT VARIABLES — grouped by category (Azure production-readiness
# audit, item 5). Four kinds, each behaving differently in production:
#   SERVER RUNTIME     — read by server/index.js et al. at request time; a
#                        normal Azure App Setting, changeable without a
#                        rebuild, never bundled into anything sent to a
#                        browser.
#   FRONTEND BUILD-TIME — VITE_-prefixed; read once by `vite build` and baked
#                        as a literal into the static JS bundle. Changing one
#                        of these after the app is deployed requires a full
#                        rebuild+redeploy — it is NOT something you can
#                        change later as an Azure App Setting alone.
#   SECRET             — must never be committed, logged, or exposed via a
#                        VITE_ variable. This file only ever holds a
#                        placeholder/blank for these; real values live in
#                        each environment's own .env (gitignored) or the
#                        Azure App Settings blade.
#   NON-SECRET CONFIG  — safe to see in a screenshot or log line, but still
#                        environment-specific.
# =============================================================================

# --- SERVER RUNTIME (non-secret) --------------------------------------------
SERVER_BASE_URL=http://localhost:4000
FRONTEND_BASE_URL=http://localhost:5173
PORT=4000

# Central database — the single source of truth for all dashboard data
# (connections, imported records, sync history), shared by every user who
# accesses this hosted app. Local dev defaults to a file-based SQLite
# database if unset. In production this MUST point outside the deployed
# code directory (Azure App Service replaces the code directory on every
# redeploy; only /home and its subpaths persist) — e.g.
# DATABASE_URL=file:/home/data/app.sqlite. Do not hard-code credentials
# here — set the real value in each environment's actual .env / App Setting.
DATABASE_URL=file:./data/app.sqlite

# --- SECRETS -----------------------------------------------------------------
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret

# 32+ byte key used to encrypt stored provider credentials (OAuth tokens,
# API keys) at rest. Required in any real deployment — without it the server
# falls back to an insecure built-in development key and logs a warning.
# Set this explicitly as an Azure App Setting; do not rely on NODE_ENV alone
# to catch a missing value.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Microsoft Entra ID SSO — HUMAN USER sign-in to the dashboard itself
# (server/auth/*). Deliberately separate from any provider's own Microsoft
# Graph APPLICATION connection (added from Data Sources -> Microsoft 365,
# stored encrypted in the `connections` table) — that's for data ingestion,
# this is for "who is allowed to open this app at all." May point at the
# SAME Azure AD app registration as a Microsoft 365 data connection (just
# add the redirect URI below and the openid/profile/email/User.Read
# delegated scopes to it, with admin consent) or a dedicated one.
# Redirect URI to register on the app: {SERVER_BASE_URL}/auth/microsoft/callback
ENTRA_SSO_TENANT_ID=
ENTRA_SSO_CLIENT_ID=
ENTRA_SSO_CLIENT_SECRET=

# 32+ byte random string signing the session cookie. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Claude automatic OneDrive/SharePoint MTD source: this is only a BOOTSTRAP
# default for a brand-new deployment with no password configured yet — the
# primary way to set/change it is the password field on the Claude data
# source page itself (Data Sources -> Claude), which posts to
# /api/claude/password. Either way it's stored through the same encrypted
# credential mechanism every other provider's secrets use
# (server/crypto.js) — never logged, never returned by any API response,
# never sent to the frontend. This is a plain SharePoint/OneDrive
# anonymous-link password, unrelated to Microsoft Graph or the Microsoft
# 365 connection (see server/services/claude/shareLinkAuth.js).
CLAUDE_ONEDRIVE_PASSWORD=

# --- NON-SECRET CONFIG --------------------------------------------------------
# Bootstrap administrator group (Part 18 of the auth spec) — members of
# this Microsoft 365 security group are always treated as Admin with every
# page, even before any role/group mapping has been configured through the
# app's own Access Management screen. Accepts a group display name
# (resolved to its Graph id on first use, same lookup every other security
# group in this app already goes through) or a raw Entra group id (GUID).
# Once real mappings are configured, this can be left as-is as a permanent
# safety net against ever being locked out, or cleared if not wanted.
BOOTSTRAP_ADMIN_GROUP=

# Kiro and Microsoft Copilot accounts are added from the Data Sources UI —
# their credentials (API keys, Azure AD app registration, OAuth client
# id/secret) are entered per-account there, not via environment variables.

# --- FRONTEND BUILD-TIME (VITE_-prefixed; inlined into the bundle when -------
# --- `npm run build` / `vite build` runs — see vite.config.js) --------------
# Used by Vite's dev proxy (server-side, dev only) and, once bundled, by the
# browser itself to build the absolute URL for the GitHub OAuth popup window
# (src/pages/DataSourcesGithub.jsx). Must match SERVER_BASE_URL above.
# REQUIRED for a production build — vite.config.js deliberately fails
# `vite build` if this is unset, because there is no way to supply it later
# as a runtime Azure App Setting once the bundle is built. Local dev is
# unaffected (vite.config.js only enforces this for `vite build`, not
# `vite`/`vite dev`).
VITE_SERVER_BASE_URL=http://localhost:4000
